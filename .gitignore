# 项目生成物：成品和缓存均可由 make 重建
/_output/
/_build/

# LaTeX 中间文件：不忽略 PDF，以便保留校徽与 Lab 标识
*.aux
*.bbl
*.bcf
*.blg
*.fdb_latexmk
*.fls
*.lof
*.log
*.lot
*.nav
*.out
*.run.xml
*.snm
*.synctex
*.synctex.gz
*.toc
*.xdv
*.vrb
*.dvi
*.latexmk.lock

# Python 环境、缓存和检查报告
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.pyright/
.coverage
.coverage.*
htmlcov/
*.egg-info/
build/
dist/

# macOS / Finder / iCloud 本地占位与临时文件
.DS_Store
.AppleDouble/
.LSOverride
._*
.Spotlight-V100/
.Trashes/
*.icloud

# 编辑器临时文件；保留共享 .vscode/settings.json 和格式规则
*~
*.swp
*.swo
*.tmp
*.bak
*.orig
.idea/
.vscode/*.log
.vscode/*.db

# 本机环境变量与密钥；示例配置可以提交
.env
.env.*
!.env.example
